#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBLOJ_MIG
    Migracao idempotente da frente de loja GEBAN (schema de empresa).
    Cria a tabela GBE_FIADO_LIMITE (limite e saldo fiado por cliente)
    via GEBDBTableEnsure. As tabelas GLJ1-GLJ6 sao criadas por
    GEBLOJMIG() em GEBLOJ.prw; GLJ8-GLJH por GEBLOJCADMIG() em
    GEBLOJ_CAD.prw. Esta funcao so' complementa com a tabela de
    controle de fiado.
    @type Modulo de migracao (por empresa)
    @author Peder Munksgaard
    @since 21/10/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function GEBLOJFMIG()
    Local aArea := GetArea()
    Local lOk   := .T.

    ConOut("GEBLOJFMIG criando GBE_FIADO_LIMITE")

    lOk := (lOk .And. GEBDBTableEnsure("GBE_FIADO_LIMITE", ;
        "CREATE TABLE GBE_FIADO_LIMITE (" + ;
        "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', " + ;
        "GFL_FILIAL TEXT NOT NULL, " + ;
        "GFL_CLI TEXT NOT NULL, " + ;
        "GFL_LIMITE NUMERIC(18,2) NOT NULL DEFAULT 0, " + ;
        "GFL_SALDO NUMERIC(18,2) NOT NULL DEFAULT 0, " + ;
        "GFL_DTALT TEXT NOT NULL DEFAULT '', " + ;
        "GFL_USALT TEXT NOT NULL DEFAULT '')", ;
        {}))

    TCSqlExec("CREATE INDEX IF NOT EXISTS GFL_FILIAL_CLI ON GBE_FIADO_LIMITE (GFL_FILIAL, GFL_CLI)")

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf

Return lOk

/*/{Protheus.doc} GEBFIAQRL
    Consulta o saldo em aberto de fiado de um cliente. Soma os titulos
    em GLJ5 com forma 'FI' cujos cupons nao foram cancelados e nao
    receberam devolucao via GLJF.
    @type Consulta fiado
    @author Peder Munksgaard
    @since 21/10/2026
    @param cCliente Codigo do cliente
    @return Numeric valor do saldo em aberto
/*/
User Function GEBFIAQRL(cCliente)
    Local aHit   := {}
    Local nSaldo := 0
    Local cFil   := FWxFilial("GLJ5")

    cCliente := BOCOL(cCliente)
    If cCliente == ""
        Return 0
    EndIf

    aHit := TCSqlQuery("SELECT COALESCE(SUM(GLJ5_VALOR), 0) AS SALDO FROM GLJ5 " + ;
        "JOIN GLJ3 ON GLJ3_FILIAL = GLJ5_FILIAL AND GLJ3_CUPOM = GLJ5_CUPOM " + ;
        "AND GLJ3.D_E_L_E_T_ = ' ' " + ;
        "WHERE GLJ5_FILIAL = " + GEBDBQuote(cFil) + " " + ;
        "AND GLJ5_FORMA = 'FI' " + ;
        "AND GLJ3_STATUS = 'VENDIDO' " + ;
        "AND GLJ3.D_E_L_E_T_ = ' ' " + ;
        "AND GLJ5.D_E_L_E_T_ = ' ' " + ;
        "AND GLJ3_CLI = " + GEBDBQuote(cCliente))

    If Len(aHit) > 0
        nSaldo := BOVAL(aHit[1]:SALDO)
    EndIf

Return nSaldo

/*/{Protheus.doc} GEBFIASETLIM
    Define o limite de credito fiado de um cliente. Se o registro
    nao existir, e' criado; se existir, e' atualizado.
    @type Cadastro fiado
    @author Peder Munksgaard
    @since 21/10/2026
    @param cCliente Codigo do cliente
    @param nLimite Limite de credito (numeric)
    @return {lOk, cMsg}
/*/
User Function GEBFIASETLIM(cCliente, nLimite)
    Local aArea  := GetArea()
    Local cFil   := FWxFilial("GBE_FIADO_LIMITE")
    Local cData  := BOHOJE()
    Local cUsu   := ""
    Local lOk    := .T.
    Local aHit   := {}

    cCliente := BOCOL(cCliente)
    nLimite  := Round(BOVAL(nLimite), 2)

    If cCliente == ""
        Return {.F., "cliente_vazio", 0}
    EndIf

    If !GEBDBTableExistsHere("GBE_FIADO_LIMITE")
        Return {.F., "tabela_nao_existente", 0}
    EndIf

    aHit := TCSqlQuery("SELECT R_E_C_N_O_ FROM GBE_FIADO_LIMITE " + ;
        "WHERE GFL_FILIAL = " + GEBDBQuote(cFil) + " " + ;
        "AND GFL_CLI = " + GEBDBQuote(cCliente) + " " + ;
        "AND D_E_L_E_T_ = ' '")

    If Len(aHit) == 0
        TCSqlExec("INSERT INTO GBE_FIADO_LIMITE (D_E_L_E_T_, GFL_FILIAL, GFL_CLI, GFL_LIMITE, GFL_SALDO, GFL_DTALT, GFL_USALT) " + ;
            "VALUES (' ', " + GEBDBQuote(cFil) + ", " + GEBDBQuote(cCliente) + ", " + cValToChar(nLimite) + ", 0, '" + cData + "', '')")
    Else
        TCSqlExec("UPDATE GBE_FIADO_LIMITE SET GFL_LIMITE = " + cValToChar(nLimite) + ;
            ", GFL_DTALT = '" + cData + "' " + ;
            "WHERE GFL_FILIAL = " + GEBDBQuote(cFil) + " " + ;
            "AND GFL_CLI = " + GEBDBQuote(cCliente) + " " + ;
            "AND D_E_L_E_T_ = ' '")
    EndIf

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf

Return {.T., "limite_definido", nLimite}

/*/{Protheus.doc} GEBFIASALDO
    Consulta o limite e saldo atual de fiado de um cliente.
    @type Consulta fiado
    @author Peder Munksgaard
    @since 21/10/2026
    @param cCliente Codigo do cliente
    @return {lOk, cMsg, {limite, saldo, disponivel}}
/*/
User Function GEBFIASALDO(cCliente)
    Local aArea  := GetArea()
    Local cFil   := FWxFilial("GBE_FIADO_LIMITE")
    Local aHit   := {}
    Local nLim   := 0
    Local nSal   := 0
    Local nDisp  := 0

    cCliente := BOCOL(cCliente)

    If !GEBDBTableExistsHere("GBE_FIADO_LIMITE")
        If Len(aArea) > 0
            RestArea(aArea)
        EndIf
        Return {.F., "tabela_nao_existente", {0, 0, 0}}
    EndIf

    aHit := TCSqlQuery("SELECT GFL_LIMITE, GFL_SALDO FROM GBE_FIADO_LIMITE " + ;
        "WHERE GFL_FILIAL = " + GEBDBQuote(cFil) + " " + ;
        "AND GFL_CLI = " + GEBDBQuote(cCliente) + " " + ;
        "AND D_E_L_E_T_ = ' '")

    If Len(aHit) > 0
        nLim := BOVAL(aHit[1]:GFL_LIMITE)
        nSal := GEBFIAQRL(cCliente)
    Else
        nLim := 0
        nSal := 0
    EndIf

    nDisp := nLim - nSal

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf

Return {.T., "saldo_fiado", {nLim, nSal, nDisp}}
