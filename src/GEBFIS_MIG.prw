#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBFIS_MIG
    Migracao idempotente do fiscal GEBAN (schema de empresa). Cria
    GF1-GF6 via GEBDBTableEnsure. CALCIBS calcula IBS/CBS sobre uma
    base (pura, sem SQL). ALIQF busca a aliquota vigente em GF2 por
    NCM+data.
    @type Modulo de migracao (por empresa)
    @author Peder Munksgaard
    @since 23/09/2026
    @param nBase Base de calculo (CALCIBS)
    @param nAliqIBS Aliquota IBS em % (CALCIBS)
    @param nAliqCBS Aliquota CBS em % (CALCIBS)
    @param cNCM NCM buscado em GF2 (ALIQF)
    @param dData Data de vigencia YYYYMMDD ou Date (ALIQF)
    @return .T. se migracao OK, .F. se falhar (GEBFMIG); array {nIBS, nCBS} (CALCIBS/ALIQF)
/*/
User Function GEBFMIG()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GEBFMIG criando GF1-GF6")
    lOk := (lOk .AND. CriaGF1())
    lOk := (lOk .AND. CriaGF2())
    lOk := (lOk .AND. CriaGF3())
    lOk := (lOk .AND. CriaGF4())
    lOk := (lOk .AND. CriaGF5())
    lOk := (lOk .AND. CriaGF6())

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

User Function CALCIBS(nBase, nAliqIBS, nAliqCBS)
    Local nIBS := 0
    Local nCBS := 0

    If nBase == Nil
        nBase := 0
    EndIf
    If nAliqIBS == Nil
        nAliqIBS := 0
    EndIf
    If nAliqCBS == Nil
        nAliqCBS := 0
    EndIf

    nIBS := nBase * nAliqIBS / 100
    nCBS := nBase * nAliqCBS / 100
Return {nIBS, nCBS}

User Function ALIQF(cNCM, dData)
    Local aArea := GetArea()
    Local cData := ""
    Local cFil := FWxFilial("GF2")
    Local nIBS := 0
    Local nCBS := 0
    Local aHit := {}
    Local oRow := Nil
    Local nIdx := 0

    If cNCM == Nil
        cNCM := ""
    EndIf
    If dData == Nil
        dData := ""
    EndIf

    If ValType(dData) == "D"
        cData := DToS(dData)
    Else
        cData := dData
    EndIf

    If !GEBDBTableExistsHere("GF2")
        If Len(aArea) > 0
            RestArea(aArea)
        EndIf
        Return {nIBS, nCBS}
    EndIf

    aHit := TCSqlQuery("SELECT GF2_IBS, GF2_CBS, GF2_INI, GF2_FIM FROM GF2 WHERE " + ;
        "GF2_FILIAL = " + GEBDBQuote(cFil) + " AND GF2_NCM = " + GEBDBQuote(AllTrim(cNCM)) + " AND D_E_L_E_T_ = ' ' AND GF2_INI <= '" + ;
        cData + "' AND GF2_FIM >= " + GEBDBQuote(cData) + "")
    For nIdx := 1 To Len(aHit)
        oRow := aHit[nIdx]
        nIBS := Val(oRow:GF2_IBS)
        nCBS := Val(oRow:GF2_CBS)
    Next nIdx

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return {nIBS, nCBS}

Static Function CriaGF1()
Return GEBDBTableEnsure("GF1", ;
    "CREATE TABLE GF1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GF1_FILIAL TEXT NOT NULL, GF1_COD TEXT NOT NULL, " + ;
    "GF1_NCM TEXT NOT NULL, GF1_DESC TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GF1_FILIAL_COD ON GF1 (GF1_FILIAL, GF1_COD)")

Static Function CriaGF2()
Return GEBDBTableEnsure("GF2", ;
    "CREATE TABLE GF2 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GF2_FILIAL TEXT NOT NULL, GF2_NCM TEXT NOT NULL, " + ;
    "GF2_IBS NUMERIC NOT NULL, GF2_CBS NUMERIC NOT NULL, GF2_INI TEXT NOT NULL, GF2_FIM TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GF2_FILIAL_NCM ON GF2 (GF2_FILIAL, GF2_NCM)")

Static Function CriaGF3()
Return GEBDBTableEnsure("GF3", ;
    "CREATE TABLE GF3 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GF3_FILIAL TEXT NOT NULL, GF3_CHAVE TEXT NOT NULL, " + ;
    "GF3_TIPO TEXT NOT NULL, GF3_STATUS TEXT NOT NULL, GF3_BASE NUMERIC(18,2) NOT NULL, " + ;
    "GF3_IBS NUMERIC(18,2) NOT NULL, GF3_CBS NUMERIC(18,2) NOT NULL, GF3_EMIS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GF3_FILIAL_CHA ON GF3 (GF3_FILIAL, GF3_CHAVE)")

Static Function CriaGF4()
Return GEBDBTableEnsure("GF4", ;
    "CREATE TABLE GF4 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GF4_FILIAL TEXT NOT NULL, GF4_CHAVE TEXT NOT NULL, " + ;
    "GF4_ITEM TEXT NOT NULL, GF4_PROD TEXT NOT NULL, GF4_QTD NUMERIC(18,4) NOT NULL, " + ;
    "GF4_PRECO NUMERIC(18,2) NOT NULL, GF4_BASE NUMERIC(18,2) NOT NULL, GF4_IBS NUMERIC(18,2) NOT NULL, GF4_CBS NUMERIC(18,2) NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GF4_FILIAL_CHA ON GF4 (GF4_FILIAL, GF4_CHAVE)")

Static Function CriaGF5()
Return GEBDBTableEnsure("GF5", ;
    "CREATE TABLE GF5 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GF5_FILIAL TEXT NOT NULL, GF5_COMP TEXT NOT NULL, " + ;
    "GF5_DEB NUMERIC(18,2) NOT NULL, GF5_CRED NUMERIC(18,2) NOT NULL, GF5_SALDO NUMERIC(18,2) NOT NULL, GF5_REGIME TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GF5_FILIAL_COM ON GF5 (GF5_FILIAL, GF5_COMP)")

Static Function CriaGF6()
Return GEBDBTableEnsure("GF6", ;
    "CREATE TABLE GF6 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GF6_FILIAL TEXT NOT NULL, GF6_COMP TEXT NOT NULL, " + ;
    "GF6_ORIG TEXT NOT NULL, GF6_VALOR NUMERIC(18,2) NOT NULL, GF6_TIPO TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GF6_FILIAL_COM ON GF6 (GF6_FILIAL, GF6_COMP)")
