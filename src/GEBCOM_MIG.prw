#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBCOM_MIG
    Migracao idempotente de compras GEBAN (schema de empresa). Cria
    GCP1 (fornecedor), GCP2 (cotacao), GCP3 (pedido), GCP4 (item),
    GCP5 (entrada) via GEBDBTableEnsure.
    @type Modulo de migracao (por empresa)
    @author Peder Munksgaard
    @since 23/09/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function GEBCMMIG()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GEBCMMIG criando GCP1-GCP5")
    lOk := (lOk .AND. CriaGCP1())
    lOk := (lOk .AND. CriaGCP2())
    lOk := (lOk .AND. CriaGCP3())
    lOk := (lOk .AND. CriaGCP4())
    lOk := (lOk .AND. CriaGCP5())

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

Static Function CriaGCP1()
Return GEBDBTableEnsure("GCP1", ;
    "CREATE TABLE GCP1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GCP1_FILIAL TEXT NOT NULL, GCP1_COD TEXT NOT NULL, " + ;
    "GCP1_NOME TEXT NOT NULL, GCP1_CNPJ TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GCP1_FILIAL_COD ON GCP1 (GCP1_FILIAL, GCP1_COD)")

Static Function CriaGCP2()
Return GEBDBTableEnsure("GCP2", ;
    "CREATE TABLE GCP2 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GCP2_FILIAL TEXT NOT NULL, GCP2_FORN TEXT NOT NULL, " + ;
    "GCP2_PROD TEXT NOT NULL, GCP2_PRECO NUMERIC(18,2) NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GCP2_FILIAL_PROD ON GCP2 (GCP2_FILIAL, GCP2_PROD)")

Static Function CriaGCP3()
Return GEBDBTableEnsure("GCP3", ;
    "CREATE TABLE GCP3 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GCP3_FILIAL TEXT NOT NULL, GCP3_NUM TEXT NOT NULL, " + ;
    "GCP3_FORN TEXT NOT NULL, GCP3_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GCP3_FILIAL_NUM ON GCP3 (GCP3_FILIAL, GCP3_NUM)")

Static Function CriaGCP4()
Return GEBDBTableEnsure("GCP4", ;
    "CREATE TABLE GCP4 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GCP4_FILIAL TEXT NOT NULL, GCP4_PED TEXT NOT NULL, " + ;
    "GCP4_PROD TEXT NOT NULL, GCP4_QTD NUMERIC(18,4) NOT NULL, GCP4_PRECO NUMERIC(18,2) NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GCP4_FILIAL_PED ON GCP4 (GCP4_FILIAL, GCP4_PED)")

Static Function CriaGCP5()
Return GEBDBTableEnsure("GCP5", ;
    "CREATE TABLE GCP5 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GCP5_FILIAL TEXT NOT NULL, GCP5_NF TEXT NOT NULL, " + ;
    "GCP5_PED TEXT NOT NULL, GCP5_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GCP5_FILIAL_NF ON GCP5 (GCP5_FILIAL, GCP5_NF)")
