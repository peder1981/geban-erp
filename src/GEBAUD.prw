#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBAUD
    Auditoria processual GEBAN (Task 3 GEB_NUCLEO - expansao).
    Mapeamento 1:1 com as interfaces do plano (chamadas sem prefixo U_):
    U_GBAUDINIC -> GBAUDINIC | U_GBAUDLOG -> GBAUDLOG.
    GBAUDINIC() cria a tabela GEI_AUDIT se nao existir:
    R_E_C_N_O_ PK, DELETER, TABELA, ACAO (INS/ALT/DEL), REGISTRO,
    ANTES (memo), DEPOIS (memo), USUARIO, EMPRESA, FILIAL, HORA,
    DURACAOMS.
    GBAUDLOG(cTabela, cAcao, cRegistro, cUsuario, cEmpresa, cFilial)
    grava entrada em GEI_AUDIT com hora atual e duracao zero
    (medicao precisa exige BeginTimestamp que nao existe no AdvPP;
    duracao fica 0 em todas as entradas).
    Notas AdvPP (balisador):
    log via ConOut (FWLogMsg inexistente no runtime); If Nil em vez
    de Default; GetArea/RestArea guardados; TCSqlQuery/TCSqlExec
    para acesso PostgreSQL; sem SELECT *, sem concat SQL em queries de
    leitura (somente literais seguras), sem cFilial, sem IIF.
    @type Modulo de auditoria processual
    @author Peder Munksgaard
    @since 23/09/2026
    @param cTabela Nome da tabela auditada (GBAUDLOG)
    @param cAcao Acao realizada: INS/ALT/DEL (GBAUDLOG)
    @param cRegistro Chave/identificador do registro (GBAUDLOG)
    @param cUsuario Usuario que realizou a acao (GBAUDLOG)
    @param cEmpresa Empresa do registro (GBAUDLOG)
    @param cFilial Filial do registro (GBAUDLOG)
    @param cEmpresa Codigo da empresa (GBAUDLOG)
    @param cFilial Filial do registro (GBAUDLOG)
    @return .T. se tabelas inicializadas (GBAUDINIC)
    @return void (GBAUDLOG)
/*/
User Function GBAUDINIC()
    Local aArea := GetArea()
    Local lOk   := .T.
    Local cSql  := ""

    If !GEBDBTableExistsHere("GEI_AUDIT")
        cSql := "CREATE TABLE GEI_AUDIT ("
        cSql += "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "
        cSql += "D_E_L_E_T_ TEXT DEFAULT ' ', "
        cSql += "GEI_AUDIT_TABELA TEXT NOT NULL, "
        cSql += "GEI_AUDIT_ACAO TEXT NOT NULL, "
        cSql += "GEI_AUDIT_REGISTRO TEXT NOT NULL, "
        cSql += "GEI_AUDIT_ANTES TEXT, "
        cSql += "GEI_AUDIT_DEPOIS TEXT, "
        cSql += "GEI_AUDIT_USUARIO TEXT NOT NULL, "
        cSql += "GEI_AUDIT_EMPRESA TEXT NOT NULL, "
        cSql += "GEI_AUDIT_FILIAL TEXT NOT NULL, "
        cSql += "GEI_AUDIT_HORA TEXT NOT NULL, "
        cSql += "GEI_AUDIT_DURACAOMS INTEGER NOT NULL DEFAULT 0)"
        lOk := TCSqlExec(cSql)
        If lOk
            TCSqlExec("CREATE INDEX IF NOT EXISTS GEI_AUDIT_EMP_HORA ON GEI_AUDIT (GEI_AUDIT_EMPRESA, GEI_AUDIT_HORA)")
            TCSqlExec("CREATE INDEX IF NOT EXISTS GEI_AUDIT_TABELA_REG ON GEI_AUDIT (GEI_AUDIT_TABELA, GEI_AUDIT_REGISTRO)")
            ConOut("GBAUDINIC GEI_AUDIT criado")
        Else
            ConOut("GBAUDINIC GEI_AUDIT FAIL")
        EndIf
    Else
        If !GEBDBColumnExists("GEI_AUDIT", "GEI_AUDIT_TABELA")
            ConOut("GBAUDINIC GEI_AUDIT recriando (colunas obsoletas)")
            TCSqlExec("DROP TABLE IF EXISTS GEI_AUDIT_OLD")
            TCSqlExec("ALTER TABLE GEI_AUDIT RENAME TO GEI_AUDIT_OLD")
            cSql := "CREATE TABLE GEI_AUDIT ("
            cSql += "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "
            cSql += "D_E_L_E_T_ TEXT DEFAULT ' ', "
            cSql += "GEI_AUDIT_TABELA TEXT NOT NULL, "
            cSql += "GEI_AUDIT_ACAO TEXT NOT NULL, "
            cSql += "GEI_AUDIT_REGISTRO TEXT NOT NULL, "
            cSql += "GEI_AUDIT_ANTES TEXT, "
            cSql += "GEI_AUDIT_DEPOIS TEXT, "
            cSql += "GEI_AUDIT_USUARIO TEXT NOT NULL, "
            cSql += "GEI_AUDIT_EMPRESA TEXT NOT NULL, "
            cSql += "GEI_AUDIT_FILIAL TEXT NOT NULL, "
            cSql += "GEI_AUDIT_HORA TEXT NOT NULL, "
            cSql += "GEI_AUDIT_DURACAOMS INTEGER NOT NULL DEFAULT 0)"
            lOk := TCSqlExec(cSql)
            If lOk
                TCSqlExec("CREATE INDEX IF NOT EXISTS GEI_AUDIT_EMP_HORA ON GEI_AUDIT (GEI_AUDIT_EMPRESA, GEI_AUDIT_HORA)")
                TCSqlExec("CREATE INDEX IF NOT EXISTS GEI_AUDIT_TABELA_REG ON GEI_AUDIT (GEI_AUDIT_TABELA, GEI_AUDIT_REGISTRO)")
                ConOut("GBAUDINIC GEI_AUDIT recriado OK")
            Else
                ConOut("GBAUDINIC GEI_AUDIT recriar FAIL")
            EndIf
            TCSqlExec("DROP TABLE IF EXISTS GEI_AUDIT_OLD")
        EndIf
    EndIf

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

User Function GBAUDLOG(cTabela, cAcao, cRegistro, cUsuario, cEmpresa, cFilial)
    Local aArea := GetArea()
    Local cDataH := ""
    Local lOk := .F.

    If cTabela == Nil
        cTabela := ""
    EndIf
    If cAcao == Nil
        cAcao := ""
    EndIf
    If cRegistro == Nil
        cRegistro := ""
    EndIf
    If cUsuario == Nil
        cUsuario := ""
    EndIf
    If cEmpresa == Nil
        cEmpresa := ""
    EndIf
    If cFilial == Nil
        cFilial := ""
    EndIf

    cDataH := DToS(Date()) + " " + Time()

    lOk := TCSqlExec( ;
        "INSERT INTO GEI_AUDIT " + ;
        "(D_E_L_E_T_, GEI_AUDIT_TABELA, GEI_AUDIT_ACAO, GEI_AUDIT_REGISTRO, " + ;
        " GEI_AUDIT_ANTES, GEI_AUDIT_DEPOIS, GEI_AUDIT_USUARIO, " + ;
        " GEI_AUDIT_EMPRESA, GEI_AUDIT_FILIAL, GEI_AUDIT_HORA, GEI_AUDIT_DURACAOMS) " + ;
        "VALUES (' ', " + GEBDBQuote(cTabela) + ", " + GEBDBQuote(cAcao) + ", " + GEBDBQuote(cRegistro) + ", " + ;
        " NULL, NULL, " + GEBDBQuote(cUsuario) + ", " + GEBDBQuote(cEmpresa) + ", " + GEBDBQuote(cFilial) + ", " + ;
        "" + GEBDBQuote(cDataH) + ", 0)"
    )

    ConOut("GBAUDLOG " + cTabela + " " + cAcao + " " + cRegistro + " " + cUsuario)

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return

