#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBEXP_MIG
    Cria tabelas de auditoria por empresa: GEH (historico de acesso) e
    GEI (audit log processual). Chamada por GEBDBProvisionaEmpresa
    (GEBDB_TENANT.prw), dentro do schema emp_<cod> ja selecionado.
    A antiga logica de adicionar coluna EMPRESA a 28 tabelas foi
    aposentada: o isolamento agora e' o proprio schema Postgres.
    @type Modulo de auditoria (por empresa)
    @author Peder Munksgaard
    @since 23/09/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function GEBEXPCriaAuditoria()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GEBEXPCriaAuditoria: GEH/GEI")
    lOk := (lOk .And. CriaGEH())
    lOk := (lOk .And. CriaGEI())

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

// Colunas identicas as do GEBEXP_MIG.prw original (src/GEBEXP_MIG.prw:114-172),
// incluindo GEH_EMPRESA (redundante com o schema, mas mantida por
// compatibilidade com quem ja le essa coluna -- remover exigiria auditar
// todo callsite de GEH, fora de escopo desta fase).
Static Function CriaGEH()
Return GEBDBTableEnsure("GEH", ;
    "CREATE TABLE GEH (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GEH_DATA TEXT NOT NULL, GEH_HORA TEXT NOT NULL, " + ;
    "GEH_USUARIO TEXT NOT NULL, GEH_EMPRESA TEXT NOT NULL, GEH_FUNCAO TEXT NOT NULL, " + ;
    "GEH_IP TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GEH_DATA_USU ON GEH (GEH_DATA, GEH_USUARIO)")

Static Function CriaGEI()
Return GEBDBTableEnsure("GEI", ;
    "CREATE TABLE GEI (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GEI_ORIGEM TEXT NOT NULL, GEI_TABELA TEXT NOT NULL, " + ;
    "GEI_REGISTRO TEXT NOT NULL, GEI_ACAO TEXT NOT NULL, GEI_HORA TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GEI_TABELA_REG ON GEI (GEI_TABELA, GEI_REGISTRO)")
