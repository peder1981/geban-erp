#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBDER_MIG
    Migracao idempotente da derrama GEBAN (schema de empresa). Cria
    GD1 (guias), GD2 (parcelas), GD3 (cobranca) via GEBDBTableEnsure.
    Chamada por GEBDBProvisionaEmpresa (GEBDB_TENANT.prw), dentro do
    schema emp_<cod> ja selecionado.
    @type Modulo de migracao (por empresa)
    @author Peder Munksgaard
    @since 23/09/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function GEBDMIG()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GEBDMIG criando GD1-GD3")
    lOk := (lOk .AND. CriaGD1())
    lOk := (lOk .AND. CriaGD2())
    lOk := (lOk .AND. CriaGD3())

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

Static Function CriaGD1()
Return GEBDBTableEnsure("GD1", ;
    "CREATE TABLE GD1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GD1_FILIAL TEXT NOT NULL, GD1_GUIA TEXT NOT NULL, " + ;
    "GD1_COMP TEXT NOT NULL, GD1_VALOR NUMERIC(18,2) NOT NULL, GD1_JUROS NUMERIC(18,2) NOT NULL, " + ;
    "GD1_MULTA NUMERIC(18,2) NOT NULL, GD1_TOTAL NUMERIC(18,2) NOT NULL, GD1_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GD1_FILIAL_GUIA ON GD1 (GD1_FILIAL, GD1_GUIA)")

Static Function CriaGD2()
Return GEBDBTableEnsure("GD2", ;
    "CREATE TABLE GD2 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GD2_FILIAL TEXT NOT NULL, GD2_GUIA TEXT NOT NULL, " + ;
    "GD2_PARC TEXT NOT NULL, GD2_VALOR NUMERIC(18,2) NOT NULL, GD2_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GD2_FILIAL_GUIA ON GD2 (GD2_FILIAL, GD2_GUIA)")

Static Function CriaGD3()
Return GEBDBTableEnsure("GD3", ;
    "CREATE TABLE GD3 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GD3_FILIAL TEXT NOT NULL, GD3_GUIA TEXT NOT NULL, " + ;
    "GD3_ACAO TEXT NOT NULL, GD3_DATA TEXT NOT NULL, GD3_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GD3_FILIAL_GUIA ON GD3 (GD3_FILIAL, GD3_GUIA)")
