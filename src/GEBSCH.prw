#include "totvs.ch"
#include "GEBDB_CORE.prw"
#include "GEBDB_TENANT.prw"
#include "GEBSEC_LOGIN.prw"
#include "GEBDFE_DIST.prw"
#include "GEBSN.prw"
#include "GESSAR.prw"

/*/{Protheus.doc} GEBSCH
    Agendador de rotinas por empresa (referencia: Schedule Protheus, TOTVS).
    Conceito: cadastro de agendamentos (SCH_JOB) por empresa, executor que roda a cada minuto
    (src/GEBSCHJOB.prw) e um log de execucoes (SCH_LOG).
    Regras:
      - So' rotinas da lista fechada GEBSCHLISTA() (sem execucao dinamica de texto).
      - Horario HHMM; dia "D" (diario) ou "M01".."M28" (dia do mes).
      - Atraso: se o horario ja passou e a rotina nao rodou hoje, roda na proxima passada (uma vez por dia).
      - Uma execucao por dia por rotina; trava por empresa (pg_advisory_lock) evita execucao dupla.
      - Cadastrar/alterar agendamento: super, ou ADMIN da empresa da sessao (GEBSECPODE).
    @type Modulo de agendamento
    @since 07/11/2026
/*/

// Rotinas permitidas: {codigo, descricao}. Ampliar aqui, nunca por texto vindo do usuario.
Static Function GEBSCHLISTA()
    Local aR := {}
    AAdd(aR, {"DFE_DIST", "Coleta de NF-e de fornecedores (DF-e por NSU)"})
    AAdd(aR, {"SN_APU", "Apuracao do Simples Nacional do mes anterior"})
Return aR

// GEBSCHROTINAS() -> lista publica de rotinas {codigo, descricao} (para a tela).
User Function GEBSCHROTINAS()
Return GEBSCHLISTA()

// GEBSCHROTINAOK(cCod) -> .T. se a rotina esta na lista fechada.
User Function GEBSCHROTINAOK(cCod)
    Local aL := GEBSCHLISTA()
    Local nI := 0
    For nI := 1 To Len(aL)
        If aL[nI][1] == cCod
            Return .T.
        EndIf
    Next nI
Return .F.

// GEBSCHSOMADIG(cTxt) -> .T. se todos os caracteres forem digitos (a funcao IsDigit do AdvPP nao serve para isso).
Static Function GEBSCHSOMADIG(cTxt)
    Local nI := 0
    For nI := 1 To Len(cTxt)
        If At(SubStr(cTxt, nI, 1), "0123456789") == 0
            Return .F.
        EndIf
    Next nI
Return Len(cTxt) > 0

// GEBSCHVALIDA(cHora, cDia) -> .T. se horario HHMM e dia "D" ou "M01".."M28" sao validos.
User Function GEBSCHVALIDA(cHora, cDia)
    Local nHH := 0
    Local nMM := 0
    Local nDd := 0
    If Len(cHora) != 4 .Or. !GEBSCHSOMADIG(cHora)
        Return .F.
    EndIf
    nHH := Val(SubStr(cHora, 1, 2))
    nMM := Val(SubStr(cHora, 3, 2))
    If nHH > 23 .Or. nMM > 59
        Return .F.
    EndIf
    If cDia == "D"
        Return .T.
    EndIf
    If Len(cDia) != 3 .Or. Left(cDia, 1) != "M" .Or. !GEBSCHSOMADIG(SubStr(cDia, 2, 2))
        Return .F.
    EndIf
    nDd := Val(SubStr(cDia, 2, 2))
Return nDd >= 1 .And. nDd <= 28

// GEBSCHDEVE(cHoje, cHoraAgora, cDia, cHora, cUltExec) -> .T. se a rotina deve rodar agora.
// Funcao pura: sem relogio, sem banco. cHoje e cUltExec em AAAAMMDD; horarios em HHMM.
User Function GEBSCHDEVE(cHoje, cHoraAgora, cDia, cHora, cUltExec)
    Local lDia := .F.
    Local lHora := .F.
    If cUltExec == cHoje
        Return .F.
    EndIf
    If cDia == "D"
        lDia := .T.
    Else
        lDia := (cDia == "M" + SubStr(cHoje, 7, 2))
    EndIf
    lHora := (cHoraAgora >= cHora)
Return lDia .And. lHora

// Cria as tabelas de agendamento no tenant corrente (idempotente).
User Function GEBSCHMIG()
    Local lOk := .T.
    lOk := lOk .And. GEBDBTableEnsure("SCH_JOB", ;
        "CREATE TABLE SCH_JOB (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', SCH_FILIAL TEXT NOT NULL, SCH_ROTINA TEXT NOT NULL, " + ;
        "SCH_HORA TEXT NOT NULL, SCH_DIA TEXT NOT NULL, SCH_ATIVO TEXT NOT NULL DEFAULT 'S', " + ;
        "SCH_ULTEXEC TEXT NOT NULL DEFAULT '', SCH_STATUS TEXT NOT NULL DEFAULT '', " + ;
        "SCH_MSG TEXT NOT NULL DEFAULT '')", {})
    lOk := lOk .And. GEBDBTableEnsure("SCH_LOG", ;
        "CREATE TABLE SCH_LOG (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', SCH_LFILIAL TEXT NOT NULL, SCH_LROTINA TEXT NOT NULL, " + ;
        "SCH_LDATA TEXT NOT NULL, SCH_LHORA TEXT NOT NULL, SCH_LSTATUS TEXT NOT NULL, " + ;
        "SCH_LMSG TEXT NOT NULL)", {})
Return lOk

// GEBSCHAGENDA(cUsuLog, cRotina, cHora, cDia, cAtivo) -> {lOk, cMsg}. Cria ou altera o agendamento.
User Function GEBSCHAGENDA(cUsuLog, cRotina, cHora, cDia, cAtivo)
    Local cRot := AllTrim(cValToChar(cRotina))
    Local cAt  := "S"
    Local aHit := {}
    Local lOk  := .F.
    If !GEBSECPODE(cUsuLog, "", .F.)
        Return {.F., "so o super ou o ADMIN da empresa agendam rotinas"}
    EndIf
    If !GEBSCHROTINAOK(cRot)
        Return {.F., "rotina fora da lista permitida: " + cRot}
    EndIf
    If !GEBSCHVALIDA(AllTrim(cValToChar(cHora)), AllTrim(cValToChar(cDia)))
        Return {.F., "horario (HHMM) ou dia (D, M01..M28) invalido"}
    EndIf
    If cAtivo != Nil .And. cAtivo == "N"
        cAt := "N"
    EndIf
    lOk := GEBSCHMIG()
    If !lOk
        Return {.F., "falha ao preparar tabelas do agendador"}
    EndIf
    aHit := TCSqlQuery("SELECT R_E_C_N_O_ AS RID FROM SCH_JOB WHERE SCH_ROTINA = " + GEBDBQuote(cRot) + " AND D_E_L_E_T_ = ' ' LIMIT 1")
    If Len(aHit) > 0
        lOk := TCSqlExec("UPDATE SCH_JOB SET SCH_HORA = " + GEBDBQuote(AllTrim(cValToChar(cHora))) + ", SCH_DIA = " + GEBDBQuote(AllTrim(cValToChar(cDia))) + ", SCH_ATIVO = " + GEBDBQuote(cAt) + " WHERE SCH_ROTINA = " + GEBDBQuote(cRot) + " AND D_E_L_E_T_ = ' '")
    Else
        lOk := TCSqlExec("INSERT INTO SCH_JOB (D_E_L_E_T_, SCH_FILIAL, SCH_ROTINA, SCH_HORA, SCH_DIA, SCH_ATIVO) VALUES (' ', '', " + GEBDBQuote(cRot) + ", " + GEBDBQuote(AllTrim(cValToChar(cHora))) + ", " + GEBDBQuote(AllTrim(cValToChar(cDia))) + ", " + GEBDBQuote(cAt) + ")")
    EndIf
Return {lOk, "ok"}

// GEBSCHDESATIVA(cUsuLog, cRotina) -> {lOk, cMsg}. Desliga sem mexer no horario.
User Function GEBSCHDESATIVA(cUsuLog, cRotina)
    Local cRot := AllTrim(cValToChar(cRotina))
    Local lOk  := .F.
    If !GEBSECPODE(cUsuLog, "", .F.)
        Return {.F., "so o super ou o ADMIN da empresa agendam rotinas"}
    EndIf
    If !GEBSCHROTINAOK(cRot)
        Return {.F., "rotina fora da lista permitida: " + cRot}
    EndIf
    lOk := TCSqlExec("UPDATE SCH_JOB SET SCH_ATIVO = 'N' WHERE SCH_ROTINA = " + GEBDBQuote(cRot) + " AND D_E_L_E_T_ = ' '")
Return {lOk, "ok"}

// Executa uma rotina da lista fechada. Devolve {lOk, cMsg}.
User Function GEBSCHEXEC(cRot)
    Local aRes := {}
    Local cComp := ""
    Local aHit := {}
    If cRot == "DFE_DIST"
        GEBDFEDISTBUSCA()
        Return {.T., "coleta de DF-e executada"}
    EndIf
    If cRot == "SN_APU"
        aHit := TCSqlQuery("SELECT to_char(current_date - interval '1 month', 'YYYYMM') AS COMP")
        cComp := AllTrim(cValToChar(aHit[1]:COMP))
        aRes := GEBSNAPU(cComp)
        If ValType(aRes) == "A" .And. Len(aRes) >= 2
            Return {aRes[1], "apuracao " + cComp + ": " + cValToChar(aRes[2])}
        EndIf
        Return {.T., "apuracao " + cComp + " executada"}
    EndIf
Return {.F., "rotina sem execucao: " + cRot}

// Roda os agendamentos devidos do tenant corrente. Devolve quantas rotinas rodaram.
User Function GEBSCHRODA()
    Local cHoje  := DToS(Date())
    Local cAgora := SubStr(Time(), 1, 2) + SubStr(Time(), 4, 2)
    Local cEmp   := GEBDBTenantAtual()
    Local cTrava := "geban_sch_" + cEmp
    Local aTrava := {}
    Local aJobs  := {}
    Local aRes   := {}
    Local nRodou := 0
    Local nI     := 0
    If !GEBSCHMIG()
        Return 0
    EndIf
    // Booleano devolvido pelo driver nao e' confiavel como texto: o SQL converte para S/N.
    aTrava := TCSqlQuery("SELECT CASE WHEN pg_try_advisory_lock(hashtext(" + GEBDBQuote(cTrava) + ")) THEN 'S' ELSE 'N' END AS L")
    If Len(aTrava) == 0 .Or. AllTrim(cValToChar(aTrava[1]:L)) != "S"
        ConOut("GEBSCH: outra execucao ativa na empresa " + cEmp)
        Return 0
    EndIf
    aJobs := TCSqlQuery("SELECT SCH_ROTINA, SCH_HORA, SCH_DIA, SCH_ULTEXEC FROM SCH_JOB WHERE SCH_ATIVO = 'S' AND D_E_L_E_T_ = ' '")
    For nI := 1 To Len(aJobs)
        If GEBSCHDEVE(cHoje, cAgora, AllTrim(cValToChar(aJobs[nI]:SCH_DIA)), AllTrim(cValToChar(aJobs[nI]:SCH_HORA)), AllTrim(cValToChar(aJobs[nI]:SCH_ULTEXEC)))
            aRes := GEBSCHEXEC(AllTrim(cValToChar(aJobs[nI]:SCH_ROTINA)))
            nRodou := nRodou + 1
            TCSqlExec("UPDATE SCH_JOB SET SCH_ULTEXEC = " + GEBDBQuote(cHoje) + ", SCH_STATUS = " + GEBDBQuote(Iif(aRes[1], "OK", "ERRO")) + ", SCH_MSG = " + GEBDBQuote(Left(cValToChar(aRes[2]), 200)) + " WHERE SCH_ROTINA = " + GEBDBQuote(AllTrim(cValToChar(aJobs[nI]:SCH_ROTINA))) + " AND D_E_L_E_T_ = ' '")
            TCSqlExec("INSERT INTO SCH_LOG (D_E_L_E_T_, SCH_LFILIAL, SCH_LROTINA, SCH_LDATA, SCH_LHORA, SCH_LSTATUS, SCH_LMSG) VALUES (' ', '', " + GEBDBQuote(AllTrim(cValToChar(aJobs[nI]:SCH_ROTINA))) + ", " + GEBDBQuote(cHoje) + ", " + GEBDBQuote(cAgora) + ", " + GEBDBQuote(Iif(aRes[1], "OK", "ERRO")) + ", " + GEBDBQuote(Left(cValToChar(aRes[2]), 200)) + ")")
        EndIf
    Next nI
    // Gatilho Sarney: regras de reajuste de preco com agenda propria (GSK1),
    // avaliadas a cada minuto dentro da mesma trava da empresa.
    nRodou := nRodou + GESSARRUN()
    TCSqlQuery("SELECT pg_advisory_unlock(hashtext(" + GEBDBQuote(cTrava) + ")) AS U")
Return nRodou

// Roda o agendador em todas as empresas provisionadas (chamado pelo timer a cada minuto).
User Function GEBSCHALL()
    Local aEmps := TCSqlQuery("SELECT GE1_COD FROM public.GE1 WHERE D_E_L_E_T_ = ' ' ORDER BY GE1_COD")
    Local nI    := 0
    Local nTot  := 0
    For nI := 1 To Len(aEmps)
        If GEBDBSetTenant(AllTrim(cValToChar(aEmps[nI]:GE1_COD)))
            nTot := nTot + GEBSCHRODA()
        EndIf
    Next nI
    TCSqlExec("SET search_path TO public")
Return nTot
