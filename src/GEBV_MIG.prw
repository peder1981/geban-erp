#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBV_MIG
    Migracao idempotente do estoque-venda GEBAN (schema de empresa).
    Cria GV1 (saldo), GV2 (venda item), GV3 (fiado) via GEBDBTableEnsure.
    @type Modulo de migracao (por empresa)
    @author Peder Munksgaard
    @since 23/09/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function GEBVMIG()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GEBVMIG criando GV1-GV3")
    lOk := (lOk .AND. CriaGV1())
    lOk := (lOk .AND. CriaGV2())
    lOk := (lOk .AND. CriaGV3())

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

Static Function CriaGV1()
Return GEBDBTableEnsure("GV1", ;
    "CREATE TABLE GV1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GV1_FILIAL TEXT NOT NULL, GV1_PROD TEXT NOT NULL, " + ;
    "GV1_SALDO NUMERIC(18,4) NOT NULL, GV1_MIN NUMERIC(18,4) NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GV1_FILIAL_PROD ON GV1 (GV1_FILIAL, GV1_PROD)")

Static Function CriaGV2()
Return GEBDBTableEnsure("GV2", ;
    "CREATE TABLE GV2 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GV2_FILIAL TEXT NOT NULL, GV2_VENDA TEXT NOT NULL, " + ;
    "GV2_PROD TEXT NOT NULL, GV2_QTD NUMERIC(18,4) NOT NULL, GV2_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GV2_FILIAL_VENDA ON GV2 (GV2_FILIAL, GV2_VENDA)")

Static Function CriaGV3()
Return GEBDBTableEnsure("GV3", ;
    "CREATE TABLE GV3 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GV3_FILIAL TEXT NOT NULL, GV3_CLI TEXT NOT NULL, " + ;
    "GV3_VALOR NUMERIC(18,2) NOT NULL, GV3_JUROS NUMERIC(18,2) NOT NULL, GV3_MULTA NUMERIC(18,2) NOT NULL, " + ;
    "GV3_TOTAL NUMERIC(18,2) NOT NULL, GV3_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GV3_FILIAL_CLI ON GV3 (GV3_FILIAL, GV3_CLI)")
