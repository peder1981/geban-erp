#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBUNI_MIG
    Cadastro de unidades de negocio (UU, 2 digitos) + validacao.
    GEUNIMIG() cria GEU1 no schema do tenant (emp_<cod>).
    GEUVALIDA(cUni) valida o formato puro (2 chars alfanumericos).
    A filial EEUUFF referencia a unidade nas posicoes 3-4.
    @type Modulo de migracao/validacao
    @author Peder Munksgaard
    @since 25/09/2026
/*/
User Function GEUNIMIG()
    Local aArea := GetArea()
    Local lOk := .T.
    ConOut("GEUNIMIG criando GEU1")
    lOk := (lOk .And. CriaGEU1())
    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

/*/{Protheus.doc} GEUVALIDA
    Valida codigo de unidade (UU): 2 chars alfanumericos+underscore.
    @type Validacao
    @author Peder Munksgaard
    @since 25/09/2026
    @param cUni Codigo candidato
    @return .T. se formato OK
/*/
User Function GEUVALIDA(cUni)
    Local cU := ""
    If cUni == Nil
        cUni := ""
    EndIf
    cU := Upper(AllTrim(cUni))
    If Len(cU) != 2
        Return .F.
    EndIf
    If !GEBDBSchemaValido(cU)
        Return .F.
    EndIf
Return .T.

Static Function CriaGEU1()
Return GEBDBTableEnsure("GEU1", ;
    "CREATE TABLE GEU1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GEU1_FILIAL TEXT NOT NULL, GEU1_COD TEXT NOT NULL, " + ;
    "GEU1_NOME TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GEU1_FILIAL_COD ON GEU1 (GEU1_FILIAL, GEU1_COD)")
