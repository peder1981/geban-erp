#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBFIL_MIG
    Cadastro de filiais (composicao EEUUFF: 2 digitos de empresa, 2 de
    unidade de negocios, 2 de filial) + validacao do formato.
    GEFFILMIG() cria GEF1 no schema do tenant (emp_<cod>).
    GEFFILVALIDA(cEmp, cFil) valida o codigo sem tocar no banco:
    6 chars, alfanumerico+underscore, EE igual aos 2 primeiros do
    codigo da empresa (caixa alta).
    @type Modulo de migracao/validacao
    @author Peder Munksgaard
    @since 25/09/2026
/*/
User Function GEFFILMIG()
    Local aArea := GetArea()
    Local lOk := .T.
    ConOut("GEFFILMIG criando GEF1")
    lOk := (lOk .And. CriaGEF1())
    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

/*/{Protheus.doc} GEFFILVALIDA
    Valida codigo de filial EEUUFF contra a empresa (puro, sem I/O).
    @type Validacao
    @author Peder Munksgaard
    @since 25/09/2026
    @param cEmp Codigo da empresa (tenant)
    @param cFil Codigo da filial candidata
    @return .T. se formato OK
/*/
User Function GEFFILVALIDA(cEmp, cFil)
    Local cE := ""
    Local cF := ""
    If cEmp == Nil
        cEmp := ""
    EndIf
    If cFil == Nil
        cFil := ""
    EndIf
    cE := Upper(AllTrim(cEmp))
    cF := Upper(AllTrim(cFil))
    If Len(cF) != 6
        Return .F.
    EndIf
    If !GEBDBSchemaValido(cF)
        Return .F.
    EndIf
    If Len(cE) < 2
        Return .F.
    EndIf
    If SubStr(cF, 1, 2) != SubStr(cE, 1, 2)
        Return .F.
    EndIf
Return .T.

/*/{Protheus.doc} GEFFILUNI
    Extrai a unidade de negocios (UU, posicoes 3-4) do codigo EEUUFF.
    @type Helper
    @author Peder Munksgaard
    @since 25/09/2026
    @param cFil Codigo EEUUFF ja validado
    @return 2 chars da unidade ("" se invalido)
/*/
User Function GEFFILUNI(cFil)
    Local cF := ""
    If cFil == Nil
        cFil := ""
    EndIf
    cF := Upper(AllTrim(cFil))
    If Len(cF) != 6
        Return ""
    EndIf
Return SubStr(cF, 3, 2)

Static Function CriaGEF1()
Return GEBDBTableEnsure("GEF1", ;
    "CREATE TABLE GEF1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GEF1_FILIAL TEXT NOT NULL, GEF1_COD TEXT NOT NULL, " + ;
    "GEF1_NOME TEXT NOT NULL, GEF1_UNI TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GEF1_FILIAL_COD ON GEF1 (GEF1_FILIAL, GEF1_COD)")
