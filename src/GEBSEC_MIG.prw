#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBSEC_MIG
    Migracao idempotente do modulo de seguranca (catalogo global,
    schema public). Cria GE2_SEC, GE2_TOK, SEC_PERM, SEC_ADMIN_SESSION,
    GE2_EMP e garante colunas de seguranca em GE2, via GEBDBTableEnsure
    (Postgres). Chamada por GEBDBProvisionaCatalogo() (GEBDB_TENANT.prw),
    nao a cada login.
    Interface: TCSecMIG() -- assinatura preservada.
    @type Modulo de migracao seguranca (catalogo)
    @author Peder Munksgaard
    @since 23/09/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function TCSecMIG()
    Local aArea := GetArea()
    Local lOk   := .T.

    ConOut("TCSecMIG iniciando migracao seguranca (catalogo)")

    lOk := (lOk .And. GEBDBTableEnsure("GE2", "", ;
        {"SEC_SALT", "SEC_HASH", "SEC_FAILCNT", "SEC_LOCKED", "SEC_LASTLOGIN"}))

    lOk := (lOk .And. GEBDBTableEnsure("GE2_SEC", ;
        "CREATE TABLE GE2_SEC (" + ;
        "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', " + ;
        "SEC_FILIAL TEXT NOT NULL, " + ;
        "SEC_USUARIO TEXT NOT NULL, " + ;
        "SEC_SALT TEXT NOT NULL, " + ;
        "SEC_HASH TEXT NOT NULL, " + ;
        "SEC_FAILCNT INTEGER NOT NULL DEFAULT 0, " + ;
        "SEC_LOCKED TEXT NOT NULL DEFAULT '00000000', " + ;
        "SEC_LASTLOGIN TEXT NOT NULL DEFAULT '00000000', " + ;
        "SEC_PWDLAST TEXT NOT NULL DEFAULT '00000000')", ;
        {}))
    TCSqlExec("CREATE INDEX IF NOT EXISTS SEC_USU ON GE2_SEC (SEC_FILIAL, SEC_USUARIO)")

    lOk := (lOk .And. GEBDBTableEnsure("GE2_TOK", ;
        "CREATE TABLE GE2_TOK (" + ;
        "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', " + ;
        "TOK_TOKEN TEXT NOT NULL, " + ;
        "TOK_USUARIO TEXT NOT NULL, " + ;
        "TOK_EMPRESA TEXT NOT NULL, " + ;
        "TOK_FILIAL TEXT NOT NULL, " + ;
        "TOK_IP TEXT NOT NULL, " + ;
        "TOK_CREATED TEXT NOT NULL, " + ;
        "TOK_EXPIRES TEXT NOT NULL)", ;
        {}))
    TCSqlExec("CREATE INDEX IF NOT EXISTS TOK_USU_emp ON GE2_TOK (TOK_USUARIO, TOK_EMPRESA)")

    lOk := (lOk .And. GEBDBTableEnsure("SEC_PERM", ;
        "CREATE TABLE SEC_PERM (" + ;
        "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', " + ;
        "SEC_PERM_FILIAL TEXT NOT NULL, " + ;
        "SEC_PERM_PERFIL TEXT NOT NULL, " + ;
        "SEC_PERM_MENU TEXT NOT NULL, " + ;
        "SEC_PERM_ITEM TEXT NOT NULL, " + ;
        "SEC_PERM_EMPRESA TEXT NOT NULL DEFAULT '*', " + ;
        "SEC_PERM_PERMITE TEXT NOT NULL DEFAULT 'F')", ;
        {}))
    TCSqlExec("CREATE INDEX IF NOT EXISTS SEC_PERM_PERFIL ON SEC_PERM (SEC_PERM_FILIAL, SEC_PERM_PERFIL, SEC_PERM_MENU, SEC_PERM_ITEM)")
    // Migracao: SEC_PERM ganha a empresa. Linhas antigas viram '*' (todas as empresas),
    // o que preserva o comportamento anterior. Roda so' quando a coluna ainda nao existe.
    If !GEBDBColumnExists("SEC_PERM", "SEC_PERM_EMPRESA")
        lOk := (lOk .And. TCSqlExec("ALTER TABLE SEC_PERM ADD COLUMN SEC_PERM_EMPRESA TEXT NOT NULL DEFAULT '*'"))
    EndIf
    TCSqlExec("CREATE INDEX IF NOT EXISTS SEC_PERM_EMP ON SEC_PERM (SEC_PERM_PERFIL, SEC_PERM_EMPRESA, SEC_PERM_MENU, SEC_PERM_ITEM)")

    lOk := (lOk .And. GEBDBTableEnsure("SEC_ADMIN_SESSION", ;
        "CREATE TABLE SEC_ADMIN_SESSION (" + ;
        "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', " + ;
        "SEC_AST_TOKEN TEXT NOT NULL, " + ;
        "SEC_AST_USUARIO TEXT NOT NULL, " + ;
        "SEC_AST_EMPRESA TEXT NOT NULL, " + ;
        "SEC_AST_FILIAL TEXT NOT NULL, " + ;
        "SEC_AST_IP TEXT NOT NULL, " + ;
        "SEC_AST_LOGINEM TEXT NOT NULL, " + ;
        "SEC_AST_ULTIMAACAO TEXT NOT NULL, " + ;
        "SEC_AST_ROTINA TEXT NOT NULL, " + ;
        "SEC_AST_MEMORIA TEXT)", ;
        {}))
    TCSqlExec("CREATE INDEX IF NOT EXISTS SEC_AST_USU_EMP ON SEC_ADMIN_SESSION (SEC_AST_USUARIO, SEC_AST_EMPRESA)")

    lOk := (lOk .And. GEBDBTableEnsure("GE2_EMP", ;
        "CREATE TABLE GE2_EMP (" + ;
        "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', " + ;
        "GE2_EMP_FILIAL TEXT NOT NULL, " + ;
        "GE2_EMP_USUARIO TEXT NOT NULL, " + ;
        "GE2_EMP_EMPRESA TEXT NOT NULL, " + ;
        "GE2_EMP_PERFIL TEXT NOT NULL DEFAULT 'USUARIO')", ;
        {}))
    TCSqlExec("CREATE INDEX IF NOT EXISTS GE2_EMP_USU_EMP ON GE2_EMP (GE2_EMP_USUARIO, GE2_EMP_EMPRESA)")
    // Migracao: o perfil passa a ser por empresa. Cada vinculo herda o perfil global
    // que o usuario tinha em GE2 (antes a permissao era por GE2_PERFIL). Roda uma vez.
    If !GEBDBColumnExists("GE2_EMP", "GE2_EMP_PERFIL")
        lOk := (lOk .And. TCSqlExec("ALTER TABLE GE2_EMP ADD COLUMN GE2_EMP_PERFIL TEXT NOT NULL DEFAULT 'USUARIO'"))
        lOk := (lOk .And. TCSqlExec("UPDATE GE2_EMP E SET GE2_EMP_PERFIL = COALESCE(NULLIF((SELECT UPPER(TRIM(U.GE2_PERFIL)) FROM GE2 U WHERE U.GE2_COD = E.GE2_EMP_USUARIO AND U.D_E_L_E_T_ = ' ' LIMIT 1), ''), 'USUARIO') WHERE E.D_E_L_E_T_ = ' '"))
    EndIf

    // Ciclo de vida (referencia TOTVS: Bloquear / Eliminar acessos / Excluir, validade,
    // ignorar troca periodica para contas de servico, troca obrigatoria no proximo logon).
    // Colunas adicionadas so' quando faltam; padrao = comportamento atual (nada bloqueado).
    If !GEBDBColumnExists("GE2", "GE2_BLOQ")
        lOk := (lOk .And. TCSqlExec("ALTER TABLE GE2 ADD COLUMN GE2_BLOQ TEXT NOT NULL DEFAULT 'N'"))
    EndIf
    If !GEBDBColumnExists("GE2", "GE2_VALID")
        lOk := (lOk .And. TCSqlExec("ALTER TABLE GE2 ADD COLUMN GE2_VALID TEXT NOT NULL DEFAULT ''"))
    EndIf
    If !GEBDBColumnExists("GE2_SEC", "SEC_IGNEXP")
        lOk := (lOk .And. TCSqlExec("ALTER TABLE GE2_SEC ADD COLUMN SEC_IGNEXP TEXT NOT NULL DEFAULT 'N'"))
    EndIf
    If !GEBDBColumnExists("GE2_SEC", "SEC_FORCE")
        lOk := (lOk .And. TCSqlExec("ALTER TABLE GE2_SEC ADD COLUMN SEC_FORCE TEXT NOT NULL DEFAULT 'N'"))
    EndIf

    ConOut("TCSecMIG finalizado: " + Iif(lOk, "OK", "FAIL"))

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

/*/{Protheus.doc} GEBSECBOOT
    Bootstrap da conta administrativa global ("super") em instalacao
    nova. So' age quando o catalogo (GE2) nao tem NENHUM usuario ativo:
    cria "super" via GEBSECCRIAUSU() com a senha de GEBAN_SUPER_SENHA
    (ou o padrao documentado) e marca SEC_FORCE='S' -- a senha padrao
    vale apenas para o primeiro login, que exige troca imediata
    (GEBSECLOGIN retorna "TROCA_OBRIGATORIA" ate a troca ser feita).
    Catalogo ja populado: nao toca em nada -- nunca redefine credencial
    de uma instalacao existente. Chamada por GEBDBProvisionaCatalogo()
    (GEBDB_TENANT.prw) a cada boot; idempotente por construcao.
    @type Funcao de provisionamento
    @author Peder Munksgaard
    @since 08/11/2026
    @return .T. se ok ou nada a fazer, .F. se a criacao falhou
/*/
User Function GEBSECBOOT()
    Local lOk := .T.
    Local aChk := {}
    Local cSenha := ""
    Local xEnv := Nil
    Local aArea := GetArea()

    aChk := TCSqlQuery("SELECT GE2_COD FROM GE2 WHERE D_E_L_E_T_ = ' ' LIMIT 1")
    If Len(aChk) > 0
        If Len(aArea) > 0
            RestArea(aArea)
        EndIf
Return .T.
    EndIf

    // GetEnv devolve a STRING "Nil" quando a variavel nao existe (quirk
    // do runtime) -- tratar como ausente, senao a senha viraria "Nil".
    xEnv := GetEnv("GEBAN_SUPER_SENHA")
    If ValType(xEnv) == "C" .And. !Empty(AllTrim(xEnv)) .And. Upper(AllTrim(xEnv)) != "NIL"
        cSenha := AllTrim(xEnv)
    Else
        cSenha := "Geban#2026"
    EndIf

    lOk := GEBSECCRIAUSU("super", cSenha, {}, "Super Administrador", "ADMIN", .T.)
    If lOk
        lOk := TCSqlExec("UPDATE GE2_SEC SET SEC_FORCE = 'S' WHERE SEC_USUARIO = 'super' AND D_E_L_E_T_ = ' '")
    EndIf
    If lOk
        ConOut("GEBSECBOOT: conta super criada (troca de senha obrigatoria no primeiro login)")
    Else
        ConOut("GEBSECBOOT: FAIL ao criar conta super")
    EndIf

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk
