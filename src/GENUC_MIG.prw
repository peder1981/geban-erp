#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GENUC_MIG
    Migracao idempotente do nucleo GEBAN. GENMIGCatalogo() cria GE1/GE2
    (schema public, catalogo global). GENMIGEmpresa() cria GE3/GE4/GE5
    (schema emp_<cod>, por empresa). GENMIG() mantida por compatibilidade
    (chama as duas em sequencia -- uso fora do fluxo multi-tenant).
    @type Modulo de migracao
    @author Peder Munksgaard
    @since 23/09/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function GENMIGCatalogo()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GENMIGCatalogo criando GE1-GE2 (public)")
    lOk := (lOk .AND. CriaGE1())
    lOk := (lOk .AND. CriaGE2())

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

User Function GENMIGEmpresa()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GENMIGEmpresa criando GE3-GE5")
    lOk := (lOk .AND. CriaGE3())
    lOk := (lOk .AND. CriaGE4())
    lOk := (lOk .AND. CriaGE5())

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

User Function GENMIG()
Return (GENMIGCatalogo() .And. GENMIGEmpresa())

User Function GEBCFG(cChave)
    Local aArea := GetArea()
    Local cModo := ""
    Local cFil := FWxFilial("GE4")

    If cChave == Nil
        cChave := ""
    EndIf

    If !GEBDBTableExists("GE4")
        If Len(aArea) > 0
            RestArea(aArea)
        EndIf
        Return cModo
    EndIf

    DbSelectArea("GE4")
    DbGoTop()
    While !Eof()
        If GE4->GE4_FILIAL == cFil .AND. GE4->GE4_EVENTO == cChave .AND. GE4->D_E_L_E_T_ == " "
            cModo := GE4->GE4_MODO
            Exit
        EndIf
        DbSkip()
    EndDo
    DbCloseArea()
    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return cModo

/*/{Protheus.doc} GEBREGIME
    Regime tributario da empresa: SIMPLES ou REGULAR. Le o parametro REGIME
    (GE4); sem ele, a convencao antiga GE1_NOME == "SIMPLES" na linha da
    empresa da sessao; sem nenhum, REGULAR.
    @type Funcao de configuracao
    @author Peder Munksgaard
    @since 19/10/2026
    @return "SIMPLES" ou "REGULAR"
/*/
User Function GEBREGIME()
    Local cReg := Upper(AllTrim(GEBCFG("REGIME")))
    Local aHit := {}
    Local cTen := ""
    If cReg == "SIMPLES" .Or. cReg == "REGULAR"
        Return cReg
    EndIf
    If GEBDBTableExists("GE1")
        // Convencao antiga: so' a linha da propria empresa (fora de empresa, qualquer linha).
        cTen := Upper(AllTrim(GEBDBTenantAtual()))
        If !(cTen == "")
            cTen := " AND UPPER(TRIM(GE1_COD)) = " + GEBDBQuote(cTen)
        EndIf
        aHit := TCSqlQuery("SELECT GE1_NOME AS N FROM GE1 WHERE GE1_FILIAL = " + GEBDBQuote(FWxFilial("GE1")) + ;
            " AND D_E_L_E_T_ = ' ' AND TRIM(GE1_NOME) = 'SIMPLES'" + cTen)
        If Len(aHit) > 0
            Return "SIMPLES"
        EndIf
    EndIf
Return "REGULAR"

Static Function CriaGE1()
Return GEBDBTableEnsure("GE1", ;
    "CREATE TABLE GE1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GE1_FILIAL TEXT NOT NULL, GE1_COD TEXT NOT NULL, GE1_NOME TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GE1_FILIAL_COD ON GE1 (GE1_FILIAL, GE1_COD)")

Static Function CriaGE2()
Return GEBDBTableEnsure("GE2", ;
    "CREATE TABLE GE2 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GE2_FILIAL TEXT NOT NULL, GE2_COD TEXT NOT NULL, GE2_NOME TEXT NOT NULL, GE2_PERFIL TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GE2_FILIAL_COD ON GE2 (GE2_FILIAL, GE2_COD)")

Static Function CriaGE3()
Return GEBDBTableEnsure("GE3", ;
    "CREATE TABLE GE3 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GE3_FILIAL TEXT NOT NULL, GE3_COD TEXT NOT NULL, GE3_USUAR TEXT NOT NULL, " + ;
    "GE3_EVENT TEXT NOT NULL, GE3_MOTIV TEXT NOT NULL, GE3_DATA TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GE3_FILIAL_COD ON GE3 (GE3_FILIAL, GE3_COD)")

Static Function CriaGE4()
Return GEBDBTableEnsure("GE4", ;
    "CREATE TABLE GE4 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GE4_FILIAL TEXT NOT NULL, GE4_EVENTO TEXT NOT NULL, GE4_MODO TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GE4_FILIAL_EVE ON GE4 (GE4_FILIAL, GE4_EVENTO)")

Static Function CriaGE5()
Return GEBDBTableEnsure("GE5", ;
    "CREATE TABLE GE5 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GE5_FILIAL TEXT NOT NULL, GE5_CHAVE TEXT NOT NULL, GE5_PAYLD TEXT NOT NULL, GE5_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GE5_FILIAL_CHA ON GE5 (GE5_FILIAL, GE5_CHAVE)")
