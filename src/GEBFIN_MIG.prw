#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBFIN_MIG
    Migracao idempotente do financeiro GEBAN (schema de empresa). Cria
    GFN1 (contas), GFN2 (receber), GFN3 (pagar), GFN4 (movimento) via
    GEBDBTableEnsure. GEBFNCON(cConta, cNome) cria a conta em GFN1 com
    saldo 0 se nao existir (idempotente).
    @type Modulo de migracao (por empresa)
    @author Peder Munksgaard
    @since 23/09/2026
    @param cConta Codigo da conta em GFN1 (GEBFNCON)
    @param cNome Nome da conta em GFN1 (GEBFNCON)
    @return .T. se migracao/conta OK, .F. se falhar
/*/
User Function GEBFNMIG()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GEBFNMIG criando GFN1-GFN4")
    lOk := (lOk .AND. CriaGFN1())
    lOk := (lOk .AND. CriaGFN2())
    lOk := (lOk .AND. CriaGFN3())
    lOk := (lOk .AND. CriaGFN4())

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

User Function GEBFNCON(cConta, cNome)
    Local aArea := GetArea()
    Local cFil := FWxFilial("GFN1")
    Local aChk := {}

    If cConta == Nil
        cConta := ""
    EndIf
    If cNome == Nil
        cNome := ""
    EndIf
    If cConta == ""
        If Len(aArea) > 0
            RestArea(aArea)
        EndIf
        Return .F.
    EndIf

    If !GEBDBTableExistsHere("GFN1")
        If Len(aArea) > 0
            RestArea(aArea)
        EndIf
        Return .F.
    EndIf

    aChk := TCSqlQuery("SELECT GFN1_CONTA FROM GFN1 WHERE GFN1_FILIAL = '" + cFil + ;
        "' AND GFN1_CONTA = " + GEBDBQuote(AllTrim(cConta)) + " AND D_E_L_E_T_ = ' '")
    If Len(aChk) > 0
        ConOut("CON existe " + cConta)
        If Len(aArea) > 0
            RestArea(aArea)
        EndIf
        Return .T.
    EndIf

    TCSqlExec("INSERT INTO GFN1 (D_E_L_E_T_, GFN1_FILIAL, GFN1_CONTA, GFN1_NOME, GFN1_SALDO) VALUES (' ', '" + ;
        cFil + "', " + GEBDBQuote(AllTrim(cConta)) + ", '" + StrTran(AllTrim(cNome), "'", "''") + "', 0)")

    ConOut("CON " + cConta)

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return .T.

Static Function CriaGFN1()
Return GEBDBTableEnsure("GFN1", ;
    "CREATE TABLE GFN1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GFN1_FILIAL TEXT NOT NULL, GFN1_CONTA TEXT NOT NULL, " + ;
    "GFN1_NOME TEXT NOT NULL, GFN1_SALDO NUMERIC(18,2) NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GFN1_FILIAL_CONTA ON GFN1 (GFN1_FILIAL, GFN1_CONTA)")

Static Function CriaGFN2()
Return GEBDBTableEnsure("GFN2", ;
    "CREATE TABLE GFN2 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GFN2_FILIAL TEXT NOT NULL, GFN2_DOC TEXT NOT NULL, " + ;
    "GFN2_CLI TEXT NOT NULL, GFN2_VALOR NUMERIC(18,2) NOT NULL, GFN2_SALDO NUMERIC(18,2) NOT NULL, " + ;
    "GFN2_VENC TEXT NOT NULL, GFN2_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GFN2_FILIAL_DOC ON GFN2 (GFN2_FILIAL, GFN2_DOC)")

Static Function CriaGFN3()
Return GEBDBTableEnsure("GFN3", ;
    "CREATE TABLE GFN3 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GFN3_FILIAL TEXT NOT NULL, GFN3_DOC TEXT NOT NULL, " + ;
    "GFN3_FORN TEXT NOT NULL, GFN3_VALOR NUMERIC(18,2) NOT NULL, GFN3_SALDO NUMERIC(18,2) NOT NULL, " + ;
    "GFN3_VENC TEXT NOT NULL, GFN3_STATUS TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GFN3_FILIAL_DOC ON GFN3 (GFN3_FILIAL, GFN3_DOC)")

Static Function CriaGFN4()
Return GEBDBTableEnsure("GFN4", ;
    "CREATE TABLE GFN4 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GFN4_FILIAL TEXT NOT NULL, GFN4_CONTA TEXT NOT NULL, " + ;
    "GFN4_TIPO TEXT NOT NULL, GFN4_VALOR NUMERIC(18,2) NOT NULL, GFN4_DATA TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GFN4_FILIAL_CONTA ON GFN4 (GFN4_FILIAL, GFN4_CONTA)")
