#include "totvs.ch"
#include "GEBDB_CORE.prw"
#include "GENUC_MIG.prw"

/*/{Protheus.doc} GEBBOLIB
    Utilitarios comuns dos modulos do backoffice (estoque/custos,
    financeiro, contabil, compras, faturamento, frente de loja).
    - Datas em texto AAAAMMDD com aritmetica por dia juliano (no AdvPP
      4.4.5, Date + n devolve data vazia).
    - BOTAB cria tabela padrao (R_E_C_N_O_, D_E_L_E_T_, <TAB>_FILIAL + colunas).
    - BOSEQ: numerador por chave (GBS1).
    - BOREL: grade de relatorio da tela (GBR1, regerada a cada pedido; a
      primeira linha e' o cabecalho).
    - BOQ/BOQN: le um campo (texto/numero) de um JsonObject da API.
    @type Biblioteca
    @author Peder Munksgaard
    @since 18/10/2026
/*/
User Function BOMIG()
    Local lOk := .T.
    lOk := lOk .And. BOTAB("GBS1", "GBS1_CHAVE TEXT NOT NULL, GBS1_ULT INTEGER NOT NULL", "GBS1_CHAVE")
    lOk := lOk .And. BOTAB("GBR1", "GBR1_ORDEM INTEGER NOT NULL, GBR1_C1 TEXT NOT NULL, GBR1_C2 TEXT NOT NULL, " + ;
        "GBR1_C3 TEXT NOT NULL, GBR1_C4 TEXT NOT NULL, GBR1_C5 TEXT NOT NULL, GBR1_C6 TEXT NOT NULL, " + ;
        "GBR1_C7 TEXT NOT NULL, GBR1_C8 TEXT NOT NULL", "GBR1_ORDEM")
Return lOk

// BOTAB("GXX1", "GXX1_A TEXT NOT NULL, ...", "GXX1_A") -> cria se faltar + indice (filial, cIdx).
User Function BOTAB(cTab, cCols, cIdx)
    Local lOk := GEBDBTableEnsure(cTab, "CREATE TABLE " + cTab + " (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', " + cTab + "_FILIAL TEXT NOT NULL, " + cCols + ")", {})
Return lOk .And. TCSqlExec("CREATE INDEX IF NOT EXISTS " + cTab + "_FILIAL_K ON " + cTab + " (" + cTab + "_FILIAL, " + cIdx + ")")

User Function BOSTR(xVal)
    If xVal == Nil
        Return ""
    EndIf
    If ValType(xVal) == "C"
        Return xVal
    EndIf
Return cValToChar(xVal)

// Texto aparado (colunas de TCSqlQuery, campos da API).
User Function BOCOL(xVal)
Return AllTrim(BOSTR(xVal))

User Function BOVAL(xVal)
    If ValType(xVal) == "N"
        Return xVal
    EndIf
Return Val(BOSTR(xVal))

User Function BONUM(nVal, nDec)
    If nDec == Nil
        nDec := 2
    EndIf
Return AllTrim(Str(BOVAL(nVal), 20, nDec))

User Function BOQ(oReq, cCampo)
    If oReq == Nil
        Return ""
    EndIf
Return BOCOL(oReq[Upper(cCampo)])

User Function BOQN(oReq, cCampo)
    If oReq == Nil
        Return 0
    EndIf
Return BOVAL(oReq[Upper(cCampo)])

// Itens de uma lista da API: array de JsonObject -> array de arrays com os campos pedidos (numericos pelo nome em aNum).
User Function BOQITENS(oReq, cCampo, aCampos, aNum)
    Local aRet := {}
    Local aLst := {}
    Local aLin := {}
    Local nI := 0
    Local nJ := 0
    If oReq == Nil
        Return aRet
    EndIf
    aLst := oReq[Upper(cCampo)]
    If !(ValType(aLst) == "A")
        Return aRet
    EndIf
    For nI := 1 To Len(aLst)
        aLin := {}
        For nJ := 1 To Len(aCampos)
            If AScan(aNum, aCampos[nJ]) > 0
                aAdd(aLin, BOVAL(aLst[nI][Upper(aCampos[nJ])]))
            Else
                aAdd(aLin, BOCOL(aLst[nI][Upper(aCampos[nJ])]))
            EndIf
        Next nJ
        aAdd(aRet, aLin)
    Next nI
Return aRet

User Function BOHOJE()
Return DToS(Date())

// Data AAAAMMDD valida?
User Function BODATAOK(cData)
    cData := BOCOL(cData)
    If !(Len(cData) == 8) .Or. !(StrZero(Val(cData), 8) == cData)
        Return .F.
    EndIf
    If Val(SubStr(cData, 5, 2)) < 1 .Or. Val(SubStr(cData, 5, 2)) > 12
        Return .F.
    EndIf
Return BODEJDN(BOJDN(cData)) == cData

// Data vazia => hoje; invalida => "".
User Function BODATA(cData)
    cData := BOCOL(cData)
    If cData == ""
        Return BOHOJE()
    EndIf
    If !BODATAOK(cData)
        Return ""
    EndIf
Return cData

User Function BOJDN(cData)
    Local nY := Val(Left(cData, 4))
    Local nM := Val(SubStr(cData, 5, 2))
    Local nD := Val(Right(cData, 2))
    Local nA := Int((14 - nM) / 12)
    Local nY2 := nY + 4800 - nA
    Local nM2 := nM + 12 * nA - 3
Return nD + Int((153 * nM2 + 2) / 5) + 365 * nY2 + Int(nY2 / 4) - Int(nY2 / 100) + Int(nY2 / 400) - 32045

User Function BODEJDN(nJ)
    Local nA := nJ + 32044
    Local nB := Int((4 * nA + 3) / 146097)
    Local nC := nA - Int(146097 * nB / 4)
    Local nD := Int((4 * nC + 3) / 1461)
    Local nE := nC - Int(1461 * nD / 4)
    Local nM := Int((5 * nE + 2) / 153)
    Local nDia := nE - Int((153 * nM + 2) / 5) + 1
    Local nMes := nM + 3 - 12 * Int(nM / 10)
    Local nAno := 100 * nB + nD - 4800 + Int(nM / 10)
Return StrZero(nAno, 4) + StrZero(nMes, 2) + StrZero(nDia, 2)

User Function BODTADD(cData, nDias)
Return BODEJDN(BOJDN(cData) + nDias)

// Dias de cData1 ate cData2 (positivo se cData2 for depois).
User Function BODIAS(cData1, cData2)
Return BOJDN(cData2) - BOJDN(cData1)

// Parametro da empresa (GE4) com default.
User Function BOPARM(cChave, cDefault)
    Local cVal := AllTrim(BOSTR(GEBCFG(cChave)))
    If cVal == ""
        Return BOSTR(cDefault)
    EndIf
Return cVal

// Resto inteiro (nA, nB positivos).
User Function BOMOD(nA, nB)
Return nA - Int(nA / nB) * nB

// Grava parametro da empresa (GE4).
User Function BOSETPARM(cChave, cValor)
    Local cFil := FWxFilial("GE4")
    TCSqlExec("UPDATE GE4 SET D_E_L_E_T_ = '*' WHERE GE4_FILIAL = " + GEBDBQuote(cFil) + " AND GE4_EVENTO = " + GEBDBQuote(cChave) + " AND D_E_L_E_T_ = ' '")
Return TCSqlExec("INSERT INTO GE4 (D_E_L_E_T_, GE4_FILIAL, GE4_EVENTO, GE4_MODO) VALUES (' ', " + GEBDBQuote(cFil) + ", " + ;
    GEBDBQuote(cChave) + ", " + GEBDBQuote(BOSTR(cValor)) + ")")

// BOMESADD("202601", -1) -> "202512"
User Function BOMESADD(cComp, nDelta)
    Local nTot := Val(Left(cComp, 4)) * 12 + Val(Right(cComp, 2)) - 1 + nDelta
Return StrZero(Int(nTot / 12), 4) + StrZero(nTot - Int(nTot / 12) * 12 + 1, 2)

// Competencia AAAAMM valida?
User Function BOCOMPOK(cComp)
    cComp := BOCOL(cComp)
    If !(Len(cComp) == 6) .Or. !(StrZero(Val(cComp), 6) == cComp)
        Return .F.
    EndIf
Return Val(Right(cComp, 2)) >= 1 .And. Val(Right(cComp, 2)) <= 12

// Ultimo dia da competencia (AAAAMMDD).
User Function BOFIMMES(cComp)
Return BODTADD(BOMESADD(cComp, 1) + "01", -1)

/*/{Protheus.doc} BOSEQ
    Proximo numero da chave (GBS1). Devolve texto com nTam digitos.
    @type Funcao utilitaria
    @author Peder Munksgaard
    @since 18/10/2026
/*/
// ponytail: UPDATE + SELECT sem trava; com dois usuarios gravando ao mesmo tempo pode repetir -- trocar por sequence do Postgres se virar problema
User Function BOSEQ(cChave, nTam)
    Local cFil := FWxFilial("GBS1")
    Local aHit := {}
    Local cW := ""
    If nTam == Nil
        nTam := 6
    EndIf
    BOMIG()
    cW := " WHERE GBS1_FILIAL = " + GEBDBQuote(cFil) + " AND GBS1_CHAVE = " + GEBDBQuote(cChave) + " AND D_E_L_E_T_ = ' '"
    aHit := TCSqlQuery("SELECT GBS1_ULT AS N FROM GBS1" + cW)
    If Len(aHit) == 0
        TCSqlExec("INSERT INTO GBS1 (D_E_L_E_T_, GBS1_FILIAL, GBS1_CHAVE, GBS1_ULT) VALUES (' ', " + GEBDBQuote(cFil) + ", " + GEBDBQuote(cChave) + ", 1)")
        Return StrZero(1, nTam)
    EndIf
    TCSqlExec("UPDATE GBS1 SET GBS1_ULT = GBS1_ULT + 1" + cW)
    aHit := TCSqlQuery("SELECT GBS1_ULT AS N FROM GBS1" + cW)
Return StrZero(BOVAL(aHit[1]:N), nTam)

/*/{Protheus.doc} BOREL
    Regrava a grade de relatorio da tela (GBR1). aLinhas: arrays de ate 8
    colunas (numeros viram texto com 2 casas). A primeira linha e' o
    cabecalho.
    @type Funcao utilitaria
    @author Peder Munksgaard
    @since 18/10/2026
/*/
// ponytail: uma grade por empresa; dois usuarios gerando relatorio ao mesmo tempo veem o ultimo
User Function BOREL(aLinhas)
    Local cFil := FWxFilial("GBR1")
    Local cSql := ""
    Local nI := 0
    Local nJ := 0
    Local xV := Nil
    BOMIG()
    TCSqlExec("DELETE FROM GBR1 WHERE GBR1_FILIAL = " + GEBDBQuote(cFil))
    For nI := 1 To Len(aLinhas)
        cSql := "INSERT INTO GBR1 (D_E_L_E_T_, GBR1_FILIAL, GBR1_ORDEM, GBR1_C1, GBR1_C2, GBR1_C3, GBR1_C4, GBR1_C5, GBR1_C6, GBR1_C7, GBR1_C8) VALUES (' ', " + ;
            GEBDBQuote(cFil) + ", " + BONUM(nI, 0)
        For nJ := 1 To 8
            xV := ""
            If nJ <= Len(aLinhas[nI])
                xV := aLinhas[nI][nJ]
            EndIf
            If ValType(xV) == "N"
                xV := BONUM(xV, 2)
            EndIf
            cSql := cSql + ", " + GEBDBQuote(BOSTR(xV))
        Next nJ
        TCSqlExec(cSql + ")")
    Next nI
Return .T.
