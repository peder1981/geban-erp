#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBPERIF_MIG
    Migracao idempotente do modulo de periféricos GEBAN (schema de empresa).
    Cria GEP_PERIFERICOS (configuracao de impressoras, TEFs, leitores,
    balancas e gavetas) via GEBDBTableEnsure.
    @type Modulo de migracao (por empresa)
    @author Peder Munksgaard
    @since 21/10/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function GEBPERIFMIG()
    Local aArea := GetArea()
    Local lOk   := .T.

    ConOut("GEBPERIFMIG criando GEP_PERIFERICOS")

    lOk := (lOk .And. GEBDBTableEnsure("GEP_PERIFERICOS", ;
        "CREATE TABLE GEP_PERIFERICOS (" + ;
        "R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
        "D_E_L_E_T_ TEXT DEFAULT ' ', " + ;
        "GEP_FILIAL TEXT NOT NULL, " + ;
        "GEP_TIPO TEXT NOT NULL, " + ;
        "GEP_DRIVER TEXT NOT NULL, " + ;
        "GEP_CONFIG TEXT NOT NULL DEFAULT '{}', " + ;
        "GEP_NOME TEXT NOT NULL, " + ;
        "GEP_ATIVO TEXT NOT NULL DEFAULT 'S', " + ;
        "GEP_ULTIMO_TESTE TEXT, " + ;
        "GEP_STATUS TEXT NOT NULL DEFAULT 'DESCONNECTED', " + ;
        "GEP_DTALT TEXT NOT NULL, " + ;
        "GEP_USALT TEXT NOT NULL)", ;
        {}))

    TCSqlExec("CREATE INDEX IF NOT EXISTS GEP_TIPO ON GEP_PERIFERICOS (GEP_FILIAL, GEP_TIPO)")
    TCSqlExec("CREATE INDEX IF NOT EXISTS GEP_DRIVER ON GEP_PERIFERICOS (GEP_FILIAL, GEP_DRIVER)")

    ConOut("GEBPERIFMIG finalizado: " + Iif(lOk, "OK", "FAIL"))

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk
