#include "totvs.ch"
#include "GEBDB_CORE.prw"

/*/{Protheus.doc} GEBCTB_MIG
    Migracao idempotente da contabilidade GEBAN (schema de empresa).
    Cria GC1 (plano de contas), GC2 (lote), GC3 (partida dobrada),
    GC4 (parametros por evento) via GEBDBTableEnsure. Semeia GC1 com
    4 contas padrao e GC4 com o evento PADRAO (fallback do CTBLAN).
    @type Modulo de migracao (por empresa)
    @author Peder Munksgaard
    @since 23/09/2026
    @return .T. se migracao OK, .F. se falhar
/*/
User Function GEBCMIG()
    Local aArea := GetArea()
    Local lOk := .T.

    ConOut("GEBCMIG criando GC1-GC4")
    lOk := (lOk .AND. CriaGC1())
    lOk := (lOk .AND. CriaGC2())
    lOk := (lOk .AND. CriaGC3())
    lOk := (lOk .AND. CriaGC4())

    If lOk
        SeedGC1()
        SeedGC4()
    EndIf

    If Len(aArea) > 0
        RestArea(aArea)
    EndIf
Return lOk

Static Function CriaGC1()
Return GEBDBTableEnsure("GC1", ;
    "CREATE TABLE GC1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GC1_FILIAL TEXT NOT NULL, GC1_CONTA TEXT NOT NULL, " + ;
    "GC1_NOME TEXT NOT NULL, GC1_TIPO TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GC1_FILIAL_CONTA ON GC1 (GC1_FILIAL, GC1_CONTA)")

Static Function CriaGC2()
Return GEBDBTableEnsure("GC2", ;
    "CREATE TABLE GC2 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GC2_FILIAL TEXT NOT NULL, GC2_LOTE TEXT NOT NULL, " + ;
    "GC2_ORIGEM TEXT NOT NULL, GC2_VALOR NUMERIC(18,2) NOT NULL, GC2_DATA TEXT NOT NULL, " + ;
    "GC2_COMP TEXT NOT NULL, GC2_TIPO TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GC2_FILIAL_LOTE ON GC2 (GC2_FILIAL, GC2_LOTE)")

Static Function CriaGC3()
Return GEBDBTableEnsure("GC3", ;
    "CREATE TABLE GC3 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GC3_FILIAL TEXT NOT NULL, GC3_LOTE TEXT NOT NULL, " + ;
    "GC3_DC TEXT NOT NULL, GC3_CONTA TEXT NOT NULL, GC3_VALOR NUMERIC(18,2) NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GC3_FILIAL_LOTE ON GC3 (GC3_FILIAL, GC3_LOTE)")

Static Function CriaGC4()
Return GEBDBTableEnsure("GC4", ;
    "CREATE TABLE GC4 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " + ;
    "D_E_L_E_T_ TEXT DEFAULT ' ', GC4_FILIAL TEXT NOT NULL, GC4_EVENTO TEXT NOT NULL, " + ;
    "GC4_CTADEB TEXT NOT NULL, GC4_CTACRED TEXT NOT NULL, GC4_PERM TEXT NOT NULL)", ;
    {}) .And. TCSqlExec("CREATE INDEX IF NOT EXISTS GC4_FILIAL_EVE ON GC4 (GC4_FILIAL, GC4_EVENTO)")

Static Function SeedGC1()
    Local aHit := {}

    aHit := TCSqlQuery("SELECT GC1_CONTA FROM GC1 WHERE GC1_CONTA = '1.01.001' AND D_E_L_E_T_ = ' '")
    If Len(aHit) == 0
        TCSqlExec("INSERT INTO GC1 (D_E_L_E_T_, GC1_FILIAL, GC1_CONTA, GC1_NOME, GC1_TIPO) VALUES (' ', '      ', '1.01.001', 'CAIXA', 'A')")
    EndIf
    aHit := TCSqlQuery("SELECT GC1_CONTA FROM GC1 WHERE GC1_CONTA = '2.01.001' AND D_E_L_E_T_ = ' '")
    If Len(aHit) == 0
        TCSqlExec("INSERT INTO GC1 (D_E_L_E_T_, GC1_FILIAL, GC1_CONTA, GC1_NOME, GC1_TIPO) VALUES (' ', '      ', '2.01.001', 'FORNECEDORES', 'A')")
    EndIf
    aHit := TCSqlQuery("SELECT GC1_CONTA FROM GC1 WHERE GC1_CONTA = '3.01.001' AND D_E_L_E_T_ = ' '")
    If Len(aHit) == 0
        TCSqlExec("INSERT INTO GC1 (D_E_L_E_T_, GC1_FILIAL, GC1_CONTA, GC1_NOME, GC1_TIPO) VALUES (' ', '      ', '3.01.001', 'RECEITA VENDAS', 'A')")
    EndIf
    aHit := TCSqlQuery("SELECT GC1_CONTA FROM GC1 WHERE GC1_CONTA = '4.01.001' AND D_E_L_E_T_ = ' '")
    If Len(aHit) == 0
        TCSqlExec("INSERT INTO GC1 (D_E_L_E_T_, GC1_FILIAL, GC1_CONTA, GC1_NOME, GC1_TIPO) VALUES (' ', '      ', '4.01.001', 'CUSTO MERCADORIAS', 'A')")
    EndIf
Return .T.

Static Function SeedGC4()
    Local aHit := {}

    aHit := TCSqlQuery("SELECT GC4_EVENTO FROM GC4 WHERE GC4_EVENTO = 'PADRAO' AND D_E_L_E_T_ = ' '")
    If Len(aHit) == 0
        TCSqlExec("INSERT INTO GC4 (D_E_L_E_T_, GC4_FILIAL, GC4_EVENTO, GC4_CTADEB, GC4_CTACRED, GC4_PERM) VALUES (' ', '      ', 'PADRAO', '1.01.001', '3.01.001', 'S')")
    EndIf
Return .T.
