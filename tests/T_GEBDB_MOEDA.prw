#include "totvs.ch"
#include "../src/GEBDB_CORE.prw"
#include "../src/GENUC_MIG.prw"
#include "../src/GEBDB_TENANT.prw"
#include "../src/GEBPERIF_MIG.prw"
#include "../src/GEBFIL_MIG.prw"
#include "../src/GEBUNI_MIG.prw"
#include "../src/GEBFIN_MIG.prw"
#include "../src/GEBDER_MIG.prw"

/*/{Protheus.doc} T_GEBDB_MOEDA
    Dinheiro exato (Fase 4 da revisao geral): valores monetarios eram REAL
    (float de 4 bytes, ~6 digitos) e perdiam centavos acima de 100 mil.
    Prova: (1) tabela nova grava 1.234.567,89 exato; (2) tabela antiga em
    REAL e' convertida por GEBDBMoedaFix com valores arredondados ao
    centavo (9,8999996 -> 9,90).
    @type Teste automatizado
    @author Peder Munksgaard
    @since 02/10/2026
    @return .T. se todos os asserts passarem
/*/
User Function T_GEBDB_MOEDA()
    Local lOk := .T.
    Local aChk := {}

    If !GEBDBConecta()
        ConOut("T_GEBDB_MOEDA FAIL")
        Return .F.
    EndIf
    TCSqlExec("SET search_path TO public")
    TCSqlExec("DROP SCHEMA IF EXISTS emp_zzmoeda CASCADE")
    TCSqlExec("CREATE SCHEMA emp_zzmoeda")
    TCSqlExec("SET search_path TO emp_zzmoeda, public")

    // (1) tabela nova (DDL atual) guarda o valor exato.
    GEBFNMIG()
    TCSqlExec("INSERT INTO GFN1 (D_E_L_E_T_, GFN1_FILIAL, GFN1_CONTA, GFN1_NOME, GFN1_SALDO) VALUES (' ', '  ', 'GRANDE', 'Conta grande', 1234567.89)")
    aChk := TCSqlQuery("SELECT GFN1_SALDO::text AS V FROM GFN1 WHERE GFN1_CONTA = 'GRANDE'")
    If Len(aChk) == 1 .And. AllTrim(aChk[1]:V) == "1234567.89"
        ConOut("  OK tabela nova: 1234567.89 gravado exato")
    Else
        lOk := .F.
        ConOut("FAIL: tabela nova gravou " + If(Len(aChk) > 0, aChk[1]:V, "nada") + " para 1234567.89")
    EndIf

    // (2) tabela antiga em REAL e' convertida, arredondando ao centavo.
    TCSqlExec("CREATE TABLE GD1 (R_E_C_N_O_ INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, D_E_L_E_T_ TEXT DEFAULT ' ', GD1_FILIAL TEXT NOT NULL, GD1_GUIA TEXT NOT NULL, GD1_COMP TEXT NOT NULL, GD1_VALOR REAL NOT NULL, GD1_JUROS REAL NOT NULL, GD1_MULTA REAL NOT NULL, GD1_TOTAL REAL NOT NULL, GD1_STATUS TEXT NOT NULL)")
    TCSqlExec("INSERT INTO GD1 (D_E_L_E_T_, GD1_FILIAL, GD1_GUIA, GD1_COMP, GD1_VALOR, GD1_JUROS, GD1_MULTA, GD1_TOTAL, GD1_STATUS) VALUES (' ', '  ', 'G1', '202610', 300, 9.9, 6, 315.9, 'ABERTA')")
    TCSqlExec("INSERT INTO GD1 (D_E_L_E_T_, GD1_FILIAL, GD1_GUIA, GD1_COMP, GD1_VALOR, GD1_JUROS, GD1_MULTA, GD1_TOTAL, GD1_STATUS) VALUES (' ', '  ', 'G2', '202610', 12345.67, 0, 0, 12345.67, 'ABERTA')")
    If !GEBDBMoedaFix()
        lOk := .F.
        ConOut("FAIL: GEBDBMoedaFix retornou .F.")
    EndIf
    aChk := TCSqlQuery("SELECT data_type AS T FROM information_schema.columns WHERE table_schema = 'emp_zzmoeda' AND data_type = 'real'")
    If Len(aChk) == 0
        ConOut("  OK nenhuma coluna REAL restante")
    Else
        lOk := .F.
        ConOut("FAIL: restaram " + cValToChar(Len(aChk)) + " colunas REAL")
    EndIf
    aChk := TCSqlQuery("SELECT GD1_JUROS::text AS J, GD1_TOTAL::text AS T FROM GD1 WHERE GD1_GUIA = 'G1'")
    If Len(aChk) == 1 .And. AllTrim(aChk[1]:J) == "9.90" .And. AllTrim(aChk[1]:T) == "315.90"
        ConOut("  OK REAL convertido ao centavo: juros 9.90 total 315.90")
    Else
        lOk := .F.
        ConOut("FAIL: conversao deu " + If(Len(aChk) > 0, aChk[1]:J + " / " + aChk[1]:T, "nada"))
    EndIf

    // 12345,67 tem 7 digitos: REAL->NUMERIC direto arredonda a 6 (12345,7).
    aChk := TCSqlQuery("SELECT GD1_VALOR::text AS V FROM GD1 WHERE GD1_GUIA = 'G2'")
    If Len(aChk) == 1 .And. AllTrim(aChk[1]:V) == "12345.67"
        ConOut("  OK REAL convertido sem perder centavo: 12345.67")
    Else
        lOk := .F.
        ConOut("FAIL: 12345.67 virou " + If(Len(aChk) > 0, aChk[1]:V, "nada"))
    EndIf
    TCSqlExec("SET search_path TO public")
    TCSqlExec("DROP SCHEMA IF EXISTS emp_zzmoeda CASCADE")
    If lOk
        ConOut("T_GEBDB_MOEDA PASS")
    Else
        ConOut("T_GEBDB_MOEDA FAIL")
    EndIf
Return lOk
